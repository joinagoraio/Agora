# Copy to .env.production on the VPS. Never commit the filled file.

NODE_ENV=production

# Public origin of the Next.js app (Caddy host)
NEXT_PUBLIC_APP_URL=https://agora.example.com
NEXT_PUBLIC_BASE_URL=https://agora.example.com

# Public origin of Kong / self-hosted Supabase API
NEXT_PUBLIC_SUPABASE_URL=https://api.agora.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

TOKEN_ENCRYPTION_KEY=
PLATFORM_SUPER_ADMIN_EMAILS=

# Optional: invite mail from the Next app (GoTrue SMTP is separate)
RESEND_API_KEY=
INVITE_EMAIL_FROM=noreply@agora.example.com

# Caddy
AGORA_APP_DOMAIN=agora.example.com
AGORA_API_DOMAIN=api.agora.example.com
ACME_EMAIL=ops@agora.example.com

# Optional Upstash. If omitted, Agora uses in-memory rate limits.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
